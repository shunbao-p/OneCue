# Python and macOS generated files
**/__pycache__/
*.py[cod]
*.pyo
.DS_Store

# Local logs, caches, temporary files, and generated media
**/*.log
**/.runtime/
**/hf_download/
**/tf_download/
**/downloaded_data/
**/tmp/
**/outputs/
**/成片/
**/临时文件/
**/日志/
**/*.zip
**/tests/evidence/**
*.bat
**/示范配音_*.wav
**/.package-a-launch.lock
**/.package-a-server.json
**/.port

# Machine-local package configuration
/【包A】视频引擎包/程序文件/config.ini

# Generated release reports stay local; retain only distributable notices/licenses
**/发布信息/*
!**/发布信息/THIRD_PARTY_NOTICES.md
!**/发布信息/licenses/
!**/发布信息/licenses/**

# Bundled release runtimes and Windows-only environment
**/runtime/
**/wzf/

# Bundled binary tools; source-mode users install FFmpeg separately
**/bin/*
!**/bin/.gitkeep

# Model weights are downloaded from Hugging Face by scripts/download_macos_models.py
**/pretrained_models/*
!**/pretrained_models/
!**/pretrained_models/README.md
!**/pretrained_models/.gitkeep
**/pretrained_models/**/model.safetensors
**/pretrained_models/**/vocoder.safetensors
**/pretrained_models/**/speaker_encoder.safetensors
**/pretrained_models/**/prompt*.wav

# Local planning/session artifacts are not part of the distributable project
.codex/
.omx/
dialogue-docs/

# Editable-install metadata generated by pip
**/*.egg-info/
