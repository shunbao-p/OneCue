{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:text-av-generator:short-video-v2:job-bundle:storyboard:v1",
  "title": "Short Video V2 Job Bundle Storyboard v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "shots"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/shot"}
    }
  },
  "$defs": {
    "voice": {
      "type": "string",
      "minLength": 5,
      "maxLength": 255,
      "pattern": "^(?!\\s)[^/\\\\\\u0000-\\u001f\\u007f]*\\S\\.wav$"
    },
    "nonblank300": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "\\S"
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head_pad_sec", "tail_pad_sec"],
      "properties": {
        "head_pad_sec": {"type": "number", "minimum": 0, "maximum": 3},
        "tail_pad_sec": {"type": "number", "minimum": 0, "maximum": 3}
      }
    },
    "speech": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": {"type": "string", "enum": ["narration", "dialogue"]},
        "text": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S"},
        "voice": {"$ref": "#/$defs/voice"},
        "speaker_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
        }
      }
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 1024},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyframe", "focus"],
      "properties": {
        "keyframe": {"$ref": "#/$defs/keyframe"},
        "focus": {"$ref": "#/$defs/focus"}
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset", "strength"],
      "properties": {
        "preset": {
          "type": "string",
          "enum": [
            "static",
            "slow_push_in",
            "slow_pull_out",
            "pan_left",
            "pan_right",
            "tilt_up",
            "tilt_down",
            "gentle_drift"
          ]
        },
        "strength": {"type": "string", "enum": ["low", "medium", "high"]},
        "intent": {"$ref": "#/$defs/nonblank300"}
      }
    },
    "caption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"type": "string", "enum": ["speech", "custom", "none"]},
        "text": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "\\S"}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "custom"}}, "required": ["mode"]},
          "then": {"required": ["text"]}
        },
        {
          "if": {"properties": {"mode": {"enum": ["speech", "none"]}}, "required": ["mode"]},
          "then": {"not": {"required": ["text"]}}
        }
      ]
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "duration_sec"],
      "properties": {
        "type": {"type": "string", "enum": ["cut", "crossfade"]},
        "duration_sec": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "cut"}}, "required": ["type"]},
          "then": {"properties": {"duration_sec": {"const": 0}}}
        },
        {
          "if": {"properties": {"type": {"const": "crossfade"}}, "required": ["type"]},
          "then": {"properties": {"duration_sec": {"minimum": 0.1, "maximum": 1.0}}}
        }
      ]
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purpose",
        "speech",
        "visual",
        "motion",
        "caption",
        "transition_out"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^shot-[0-9]{3}$"},
        "purpose": {"$ref": "#/$defs/nonblank300"},
        "speech": {"$ref": "#/$defs/speech"},
        "visual": {"$ref": "#/$defs/visual"},
        "motion": {"$ref": "#/$defs/motion"},
        "timing": {"$ref": "#/$defs/timing"},
        "caption": {"$ref": "#/$defs/caption"},
        "transition_out": {"$ref": "#/$defs/transition"},
        "hero": {"type": "boolean", "default": false}
      }
    }
  }
}
